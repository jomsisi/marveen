# Dependencies & build
node_modules
dist/

# Python bytecode cache (e.g. scripts/hooks/__pycache__/*.pyc)
__pycache__/
*.pyc

# Secrets & personal data
# GITIGNENV820: editor backups / copies of .env (.env~, .env.bak, .env.local)
# were not covered -- only the exact name was. Cover every variant, keep the
# tracked example file. *~ catches editor backups of ANY secret-bearing file.
.env
# A puszta ".env" NEM fedi a szarmazekokat, es azokban ugyanaz a titok all:
#  - .env-wm / .env-unas: a vault-resolve kimenete, amit a scriptek forrasolnak, majd torolnek.
#    Ha egy futas megszakad az "rm -f" elott, a fajl ottmarad, es egy "git add -A" becommitolna.
#  - .env.bak.*: kezi mentesek atallas elott (harom ilyen all a munkafaban).
# A kotojeles alak kulon minta kell: a ".env.*" NEM illeszkedik a ".env-unas"-ra.
.env-*
.env.*
!.env.example
*~
store/
# A fo-agens research/ mappaja a PROJECT_ROOT alatt van (agentConfigRoot -> PROJECT_ROOT),
# a sub-agenseke viszont az agents/ alatt, ami mar ignoralt. Enelkul a fo-agens uzemi
# elemzesei (bevetel, szallitoi szamlak, sajat meresek) a PUBLIKUS repoba kerulnenek.
research/
workspace/
agents/
reports/
# CLAUDEIGN820: '.claude/' (directory pattern) stopped traversal, so the
# '!.claude/settings.json' negation never fired -- the tracked settings file
# was invisible as untracked and git add refused it on fresh clones.
# '.claude/*' lets git enumerate the first level so the negation can work;
# '*/**/.claude/' keeps nested .claude dirs ignored like before.
.claude/*
!.claude/settings.json
*/**/.claude/
.config/

